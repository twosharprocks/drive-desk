{
  "app-id": "io.github.twosharprocks.DriveDesk",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "drive-desk",
  "finish-args": [
    "--share=network", "--share=ipc", "--socket=wayland", "--socket=fallback-x11",
    "--device=dri", "--filesystem=home", "--filesystem=/run/media", "--filesystem=/media",
    "--filesystem=/mnt", "--filesystem=xdg-run/gvfs", "--filesystem=xdg-run/gvfsd",
    "--talk-name=org.gnome.OnlineAccounts", "--talk-name=org.freedesktop.FileManager1",
    "--talk-name=org.gtk.vfs.*", "--talk-name=org.gnome.Settings",
    "--talk-name=org.freedesktop.Notifications",
    "--env=DRIVE_DESK_FORMAT=flatpak", "--env=DRIVE_DESK_APP_ID=io.github.twosharprocks.DriveDesk"
  ],
  "rename-desktop-file": "drive-desk.desktop",
  "modules": [
    {
      "name": "rclone",
      "buildsystem": "simple",
      "build-commands": ["install -Dm755 rclone -t /app/bin", "install -Dm644 README.txt -t /app/share/doc/rclone"],
      "sources": [{
        "type": "archive", "only-arches": ["x86_64"],
        "url": "https://downloads.rclone.org/v1.76.0/rclone-v1.76.0-linux-amd64.zip",
        "sha256": "b00f00b3266c3764413afe599d3ec316f6f43b3e0ea8a0bc1d186d2133e46df7"
      }]
    },
    {
      "name": "drive-desk",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 drive-desk /app/share/drive-desk/drive-desk",
        "install -m644 *.py /app/share/drive-desk/",
        "ln -s ../share/drive-desk/drive-desk /app/bin/drive-desk",
        "install -Dm644 drive-desk.desktop -t /app/share/applications",
        "sed -i 's/^Icon=folder-remote$/Icon=io.github.twosharprocks.DriveDesk/' /app/share/applications/drive-desk.desktop",
        "install -Dm644 drive-desk.svg /app/share/icons/hicolor/scalable/apps/io.github.twosharprocks.DriveDesk.svg",
        "install -Dm644 io.github.twosharprocks.DriveDesk.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 LICENSE /app/share/licenses/drive-desk/LICENSE"
      ],
      "sources": [
        {"type": "file", "path": "drive-desk"}, {"type": "file", "path": "cloud.py"}, {"type": "file", "path": "oauth.py"},
        {"type": "file", "path": "portable.py"}, {"type": "file", "path": "desktop_tools.py"},
        {"type": "file", "path": "sync.py"}, {"type": "file", "path": "drive-desk.desktop"},
        {"type": "file", "path": "LICENSE"},
        {"type": "file", "path": "packaging/drive-desk.svg"},
        {"type": "file", "path": "packaging/io.github.twosharprocks.DriveDesk.metainfo.xml"}
      ]
    }
  ]
}
